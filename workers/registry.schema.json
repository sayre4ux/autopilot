{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autopilot-contributors/autopilot/workers/registry.schema.json",
  "title": "Autopilot Worker Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Unique worker id; project record with same id overrides global."
    },
    "type": {
      "type": "string",
      "enum": [
        "subagent",
        "cli",
        "mcp"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "code",
          "refactor",
          "test",
          "review",
          "docs",
          "data",
          "security",
          "research"
        ]
      },
      "description": "Capability tags the orchestrator matches against a task's domain/need."
    },
    "modelFamily": {
      "type": "string",
      "description": "Free-form model family used to prefer an independent family for review."
    },
    "preferWhen": {
      "type": "string",
      "description": "When to route work to this worker."
    },
    "avoidWhen": {
      "type": "string",
      "description": "When not to route work to this worker."
    },
    "trusted": {
      "type": "boolean",
      "default": false,
      "description": "If false, require approval of the resolved command."
    },
    "subagent": {
      "$ref": "#/$defs/subagent"
    },
    "cli": {
      "$ref": "#/$defs/cli"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "mcp": {
      "$ref": "#/$defs/mcp"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "subagent"
        }
      },
      "required": [
        "subagent"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cli"
            ]
          },
          {
            "required": [
              "mcp"
            ]
          },
          {
            "required": [
              "output"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "type": {
          "const": "cli"
        }
      },
      "required": [
        "cli"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "subagent"
            ]
          },
          {
            "required": [
              "mcp"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "type": {
          "const": "mcp"
        }
      },
      "required": [
        "mcp"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "subagent"
            ]
          },
          {
            "required": [
              "cli"
            ]
          },
          {
            "required": [
              "output"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "subagent": {
      "type": "object",
      "required": [
        "subagentType"
      ],
      "additionalProperties": false,
      "properties": {
        "subagentType": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            null
          ]
        }
      }
    },
    "cli": {
      "type": "object",
      "required": [
        "command",
        "args",
        "promptDelivery",
        "timeoutSec",
        "successExitCodes"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptDelivery": {
          "type": "string",
          "enum": [
            "arg",
            "stdin",
            "file"
          ]
        },
        "cwd": {
          "type": "string",
          "default": "${workdir}"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "successExitCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            0
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "stdout",
            "file",
            "worktree"
          ],
          "default": "stdout"
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ],
          "default": "text"
        },
        "resultPointer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "tool",
        "argsTemplate",
        "timeoutSec"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "argsTemplate": {
          "type": "object"
        },
        "resultField": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
