{
  "id": "codex-cli",
  "type": "cli",
  "displayName": "Codex CLI (independent family)",
  "capabilities": [
    "code",
    "review",
    "refactor",
    "test"
  ],
  "modelFamily": "openai",
  "preferWhen": "Independent cross-check / code review from a different model family; large mechanical refactors.",
  "avoidWhen": "Security-sensitive work; visual/document deliverables.",
  "trusted": false,
  "cli": {
    "command": "codex",
    "args": [
      "exec",
      "--cd",
      "${workdir}",
      "--skip-git-repo-check",
      "-"
    ],
    "promptDelivery": "stdin",
    "cwd": "${workdir}",
    "env": {
      "SUPERCONDUCTOR_MANAGED_AGENT": "0"
    },
    "timeoutSec": 900,
    "successExitCodes": [
      0
    ]
  },
  "output": {
    "channel": "stdout",
    "format": "text",
    "resultPointer": null
  }
}
