{
  "id": "grok-cli",
  "type": "cli",
  "displayName": "Grok Build CLI (xAI family)",
  "capabilities": [
    "code",
    "review",
    "refactor",
    "test"
  ],
  "modelFamily": "xai-grok",
  "preferWhen": "Independent cross-check / code review from a third model family; parallel second implementation of a fully specified brief.",
  "avoidWhen": "Security-sensitive work; visual/document deliverables.",
  "trusted": false,
  "cli": {
    "command": "grok",
    "args": [
      "--prompt-file",
      "${brief_path}",
      "--cwd",
      "${workdir}",
      "-m",
      "grok-4.5",
      "--output-format",
      "plain",
      "--verbatim",
      "--always-approve"
    ],
    "promptDelivery": "file",
    "cwd": "${workdir}",
    "env": {},
    "timeoutSec": 900,
    "successExitCodes": [
      0
    ]
  },
  "output": {
    "channel": "stdout",
    "format": "text",
    "resultPointer": null
  }
}
