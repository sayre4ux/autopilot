{
  // Autopilot user overlay. Copy to ~/.autopilot/config.jsonc (global) or
  // <project>/.autopilot/config.jsonc (project). Every key is optional; absent = shipped default.

  // Per-role overrides. Aliases only (opus/fable/sonnet/haiku) — never dated model ids.
  // Effort policy (Opus 5.5): medium for one-shot work where a routine defect is caught at
  // intake (engineer, engineer-doc); high where a miss is expensive or propagates (architect,
  // senior-engineer, security-engineer, verifier, reviewer). xhigh/max only behind an eval.
  // The supervisor runs on fable at high and is called at gates only (R8 in judgment.md).
  // effort is a subagent frontmatter field (values low|medium|high|xhigh|max, model-
  // dependent) that overrides the session effort while the agent runs. The Agent tool has no
  // per-call effort argument, so these values land via the definition or sc --reasoning,
  // not an Agent-tool call.
  "roles": {
    "architect":         { "model": "opus",  "effort": "high"   },
    "engineer":          { "model": "opus",  "effort": "medium" },
    "senior-engineer":   { "model": "opus",  "effort": "high"   },
    "engineer-doc":      { "model": "opus",  "effort": "medium" },
    "security-engineer": { "model": "opus",  "effort": "high"   },
    "verifier":          { "model": "opus",  "effort": "high"   },
    "reviewer":          { "model": "opus",  "effort": "high"   },
    "supervisor":        { "model": "fable", "effort": "high"   }
  },

  // Review cycle default when a job doesn't specify one. off | final | per-component.
  "reviewDefault": "off",

  // Worker layer preferences. Order = tie-break priority; false disables.
  // GPT-6 via Codex: Astra at medium effort for the design phase only (read-only, a second
  // design opinion from another family); Luna at max effort for cheap coding with long turns
  // (runs past an hour are normal). Grok 4.7 = independent third-family review, plus a fixer
  // for verified findings. Normal coding stays on the native engineer.
  "workerPreferences": {
    "gpt-6-astra-design-cli": true,
    "gpt-6-luna-max-cli":     true,
    "grok-4.7-review-cli":    true,
    "grok-4.7-fix-cli":       true,
    "opencode-cli":           true,
    // omp runs on whatever model omp itself is configured for, so it sits last: cheap bulk
    // execution, and never counted on for family independence.
    "omp-cli":                true,
    "order": ["gpt-6-astra-design-cli", "gpt-6-luna-max-cli", "grok-4.7-review-cli", "grok-4.7-fix-cli", "opencode-cli", "omp-cli"]
  },

  // Where setup installed the runner (setup writes this; edit only if you moved it).
  "workerRunner": "~/.autopilot/bin/autopilot-worker",

  // Completion wakes: finished workers wake the dispatching session, so a fan-out can end its
  // turn instead of idling. "auto" uses an sc callback when one resolves and Claude Code's
  // background-task notification otherwise; "off" forces every dispatch to run in-turn.
  // detachThresholdSec: a single worker expected to run longer than this is detached rather
  // than waited on; any fan-out of two or more is detached regardless.
  "callbacks": {
    "mode": "auto",
    "detachThresholdSec": 120
  },

  // --- ILLUSTRATIVE machine-specific entry (allowed here ONLY, never in shipped defaults) ---
  // Personal environment quirks the orchestrator should know about. Example:
  // "environmentNotes": "Python is managed by uv (never pip/venv); Node by fnm (never nvm)."
}
